---
import { Font } from "astro:assets";
import Snackbar from "@components/atoms/overlay/Snackbar.svelte";
import ConfigCarrier from "@components/system/ConfigCarrier.astro";
import UmamiRuntime from "@components/system/UmamiRuntime.astro";
import { resolveAsset } from "@utils/asset-utils";
import { pathsEqual, toAbsoluteUrl, url } from "@utils/url-utils";
import {
	expressiveCodeConfig,
	profileConfig,
	resolvedFontOptions,
	resolveUmamiOptions,
	siteConfig,
	umamiConfig,
} from "@/config";
import type { SidebarPage } from "@/types/sidebarConfig";
import { defaultFavicons } from "@constants/icon";
import type { BannerSourceValue, Favicon } from "@/types/config";
import { createFontRoleStyle } from "@utils/font-options";
import { resolvePageWidth } from "@utils/responsive-utils";
import "@fontsource/cormorant-garamond/400.css";
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@/styles/main.css";
import "@/styles/font-faces.css";
import "../styles/ethereal.css";
import GlassSvgDefs from "../components/glass/GlassSvgDefs.svelte";
import FireflyLakeBackground from "../components/scene/FireflyLakeBackground.svelte";

interface Props {
	title?: string;
	banner?: string;
	ogImage?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	page?: SidebarPage;
	initialEtherealMode?: "spatial" | "reading";
	initialInteractionMode?: "launch" | "workspace" | "reading";
}

let {
	title,
	banner,
	ogImage,
	description,
	lang,
	setOGTypeArticle,
	page,
	initialEtherealMode,
	initialInteractionMode,
} = Astro.props;

const initialPage =
	page ?? (pathsEqual(Astro.url.pathname, url("/")) ? "home" : undefined);
const cleanPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isWorkspacePath =
	cleanPath === "/" ||
	cleanPath === "/blog" ||
	cleanPath === "/archive" ||
	cleanPath === "/categories" ||
	cleanPath === "/tags" ||
	cleanPath === "/projects" ||
	cleanPath === "/gallery" ||
	cleanPath === "/about" ||
	cleanPath === "/guestbook" ||
	/^\/\d+$/.test(cleanPath);

const resolvedEtherealMode =
	initialEtherealMode ?? (isWorkspacePath ? "spatial" : "reading");
const resolvedInteractionMode =
	initialInteractionMode ??
	(cleanPath === "/" ? "launch" : isWorkspacePath ? "workspace" : "reading");

const canonicalUrl = Astro.site
	? new URL(Astro.url.pathname + Astro.url.search, Astro.site)
	: Astro.url;

function getFirstBannerImage(source: BannerSourceValue | undefined): string {
	if (!source) return "";
	if (Array.isArray(source)) return source[0] || "";
	return source.light[0] || source.dark[0] || "";
}

const defaultSocialImage =
	siteConfig.ogImage ||
	getFirstBannerImage(siteConfig.banner.src.desktop) ||
	getFirstBannerImage(siteConfig.banner.src.mobile) ||
	"";
const candidateOgImage = ogImage || banner || defaultSocialImage;
const resolvedOgImage = await resolveAsset(candidateOgImage);
const absoluteOgImage = toAbsoluteUrl(resolvedOgImage, canonicalUrl);

const configHue = siteConfig.themeColor.hue;
const lightTheme =
	expressiveCodeConfig.lightTheme ?? expressiveCodeConfig.theme;
const darkTheme = expressiveCodeConfig.darkTheme ?? expressiveCodeConfig.theme;
const defaultWallpaperMode = siteConfig.wallpaperMode.defaultMode;
const umamiOptions = resolveUmamiOptions(umamiConfig);

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");
const fontRoleStyle = createFontRoleStyle(resolvedFontOptions);
const customFontsEnabled = resolvedFontOptions.mode === "custom";
const hasBodyFont =
	customFontsEnabled && Boolean(resolvedFontOptions.roles.body.family);
const hasCjkFont =
	customFontsEnabled && Boolean(resolvedFontOptions.roles.cjk.family);
const hasMonoFont =
	customFontsEnabled && Boolean(resolvedFontOptions.roles.mono.family);
---

<!DOCTYPE html>
<html
	lang={siteLang}
	data-ethereal-mode={resolvedEtherealMode}
	data-scene-phase="blue_hour"
	data-ew-theme="dusk-station"
	data-theme={darkTheme}
	data-light-code-theme={lightTheme}
	data-dark-code-theme={darkTheme}
	class="dark transition text-[14px] md:text-[16px]"
	style={`--hue: ${configHue}`}
>
	<head>
		<style is:inline>@layer properties, theme, base, components, utilities;</style>

		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={description || pageTitle} />
		<meta name="author" content={profileConfig.name} />
		<link rel="canonical" href={canonicalUrl.href} />

		<meta property="og:site_name" content={siteConfig.title} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description || pageTitle} />
		{absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
		{setOGTypeArticle ? (
			<meta property="og:type" content="article" />
		) : (
			<meta property="og:type" content="website" />
		)}

		<meta name="twitter:card" content={absoluteOgImage ? "summary_large_image" : "summary"} />
		<meta property="twitter:url" content={canonicalUrl} />
		<meta property="twitter:title" content={pageTitle} />
		<meta property="twitter:description" content={description || pageTitle} />
		{absoluteOgImage && <meta property="twitter:image" content={absoluteOgImage} />}

		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
		/>
		<meta name="theme-color" content="#101D38" />
		<meta name="color-scheme" content="dark" />
		<meta name="generator" content={Astro.generator} />
		{fontRoleStyle && <style is:inline set:html={fontRoleStyle}></style>}
		{hasBodyFont && (
			<Font
				cssVariable={resolvedFontOptions.roles.body.cssVariable as never}
				preload={resolvedFontOptions.roles.body.preload}
			/>
		)}
		{hasCjkFont && (
			<Font
				cssVariable={resolvedFontOptions.roles.cjk.cssVariable as never}
				preload={resolvedFontOptions.roles.cjk.preload}
			/>
		)}
		{hasMonoFont && (
			<Font
				cssVariable={resolvedFontOptions.roles.mono.cssVariable as never}
				preload={resolvedFontOptions.roles.mono.preload}
			/>
		)}
		{umamiOptions?.websiteId && umamiOptions.scriptUrl && (
			<script
				is:inline
				async
				src={umamiOptions.scriptUrl}
				data-website-id={umamiOptions.websiteId}
				data-auto-track="true"
			></script>
		)}
		{favicons.map((favicon) => (
			<link
				rel="icon"
				href={favicon.src.startsWith("/") ? url(favicon.src) : favicon.src}
				sizes={favicon.sizes}
				media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		<script is:inline define:vars={{ defaultWallpaperMode, darkTheme }}>
			const root = document.documentElement;
			root.dataset.wallpaperMode = defaultWallpaperMode;
			root.classList.add("dark");
			root.setAttribute("data-theme", darkTheme);

			const validPhases = new Set(["blue_hour", "moonlit", "midnight", "dusk"]);
			if (typeof localStorage !== "undefined") {
				const savedPhase = localStorage.getItem("firefly:scene-phase");
				if (savedPhase && validPhases.has(savedPhase)) {
					root.dataset.scenePhase = savedPhase;
				}
				if (localStorage.getItem("mc-motion") === "reduced") {
					root.classList.add("motion-reduced");
				}
				if (localStorage.getItem("ethereal:glass-mode") === "solid") {
					root.dataset.ewGlass = "solid";
				}
			}
		</script>
		<style define:vars={{
			configHue,
			"page-width": resolvePageWidth(),
		}}></style>

		<slot name="head"></slot>
		<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`} />
		<link rel="alternate" type="application/atom+xml" title={profileConfig.name} href={`${Astro.site}atom.xml`} />
	</head>
	<body
		class="min-h-screen"
		data-current-page={initialPage}
	>
		<!-- 持久挂载于 Swup 替换容器之外：全局 SVG 折射滤镜与「萤火眠于湖」WebGL 交互场景 -->
		<GlassSvgDefs client:load />
		<FireflyLakeBackground interactionMode={resolvedInteractionMode} client:load />

		<ConfigCarrier></ConfigCarrier>
		{umamiOptions && <UmamiRuntime />}
		<Snackbar client:only="svelte"></Snackbar>
		<slot />
		<div id="page-height-extend" class="hidden h-[300vh]"></div>
	</body>
</html>

<style lang="stylus" is:global>
@import "../../node_modules/shirones/src/styles/variables.styl"
</style>

<script>
import { initLastUpdatedNotices } from "@utils/last-updated-notice";
import { applyCurrentScheme } from "@utils/theme-utils";
import { copyPageLink } from "@utils/copy-page-link";
import { bindFancyboxRuntime } from "@utils/fancybox-runtime";
import { sceneBridge, type TimeOfDay } from "../scene/scene-bridge";

const VALID_PHASES = new Set<TimeOfDay>(["blue_hour", "moonlit", "midnight", "dusk"]);

function isWorkspaceOrLaunchPath(pathname: string): boolean {
	const clean = pathname.replace(/\/+$/, "") || "/";
	return (
		clean === "/" ||
		clean === "/blog" ||
		clean === "/archive" ||
		clean === "/categories" ||
		clean === "/tags" ||
		clean === "/projects" ||
		clean === "/gallery" ||
		clean === "/about" ||
		clean === "/guestbook" ||
		/^\/\d+$/.test(clean)
	);
}

function syncMaterialScheme() {
	document.documentElement.classList.add("dark");
	applyCurrentScheme();
}

function syncSavedScenePhase() {
	const saved = localStorage.getItem("firefly:scene-phase") as TimeOfDay | null;
	if (saved && VALID_PHASES.has(saved)) {
		document.documentElement.dataset.scenePhase = saved;
		sceneBridge.setTimeOfDay(saved);
	}
}

function syncSwupPageMetadata() {
	const root = document.documentElement;
	const container = document.getElementById("swup-container");
	if (container) {
		const page = container.dataset.currentPage || "";
		const etherealMode = container.dataset.etherealMode === "spatial" ? "spatial" : "reading";
		document.body.dataset.currentPage = page;
		root.dataset.etherealMode = etherealMode;
	}
	syncMaterialScheme();
	initLastUpdatedNotices();
	bindFancyboxRuntime();
}

document.addEventListener("click", (event) => {
	const target = event.target;
	if (!(target instanceof Element) || !target.closest("#copy-post-link")) return;
	void copyPageLink();
});

document.addEventListener("swup:content:replace", syncSwupPageMetadata);
document.addEventListener("swup:page:view", syncSwupPageMetadata);

interface SwupRuntime {
	options: {
		skipPopStateHandling: (event: PopStateEvent) => boolean;
	};
	hooks: {
		on: (event: string, cb: () => void) => void;
	};
}

const bindSwup = () => {
	const win = window as Window & {
		swup?: SwupRuntime;
		__fireflySwupBound?: boolean;
	};
	if (!win.swup?.hooks || win.__fireflySwupBound) return;
	win.__fireflySwupBound = true;

	// Launch <-> Workspace 同壳体历史导航由 FireflyWorkspaceShell 平滑反向动画接管；
	// Workspace <-> 文章详情跨壳体导航由 Swup 无刷新替换 <main>，WebGL 持久不中断。
	win.swup.options.skipPopStateHandling = (event: PopStateEvent) => {
		const hasWorkspaceRoot = Boolean(document.getElementById("firefly-workspace-root"));
		if (hasWorkspaceRoot && isWorkspaceOrLaunchPath(window.location.pathname)) {
			return true;
		}
		const state = event.state as { source?: string } | null;
		return state?.source !== "swup";
	};

	win.swup.hooks.on("link:click", () => {
		document.documentElement.style.setProperty("--content-delay", "0ms");
	});
	win.swup.hooks.on("content:replace", syncSwupPageMetadata);
};

if ((window as Window & { swup?: unknown }).swup) bindSwup();
else document.addEventListener("swup:enable", bindSwup, { once: true });

syncSavedScenePhase();
syncSwupPageMetadata();
</script>
